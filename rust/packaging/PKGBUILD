# Local Artix/Arch package built from the adjacent, generated source archive.
pkgname=awakened-crab-trade
pkgver=0.33.0
pkgrel=1
pkgdesc='Native Rust PoE price checker for River and XWayland'
arch=('x86_64')
url='https://github.com/Shoukshai/awakened-crab-trade'
license=('MIT')
# Cargo already performs Rust thin-LTO. GCC LTO objects from ring cannot be
# consumed by rust-lld; disable makepkg's additional C/C++ LTO for this package.
options=('!lto')
depends=('gtk3' 'gtk-layer-shell' 'wl-clipboard' 'xdotool' 'coreutils' 'xdg-utils' 'libnotify')
makedepends=('rust' 'pkgconf')
source=("native-source-${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$srcdir/rust"
    export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$srcdir/target}"
    cargo build --release --locked --offline -j 3
}

check() {
    cd "$srcdir/rust"
    export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$srcdir/target}"
    cargo test --locked --offline --bin awakened-crab-trade -j 3
}

package() {
    cd "$srcdir"
    local target_dir="${CARGO_TARGET_DIR:-$srcdir/target}"
    install -Dm755 "$target_dir/release/awakened-crab-trade" "$pkgdir/usr/bin/awakened-crab-trade"
    install -Dm755 rust/packaging/awakened-crab-trade-launch "$pkgdir/usr/bin/awakened-crab-trade-launch"
    install -Dm644 rust/packaging/awakened-crab-trade.desktop "$pkgdir/usr/share/applications/awakened-crab-trade.desktop"
    install -Dm644 rust/assets/branding/icon-256.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/awakened-crab-trade.png"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    cp -a license-bundle "$pkgdir/usr/share/licenses/$pkgname/dependencies"
    install -Dm644 rust/README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    for doc in CHECKER-VALIDATION.md GAME-ART.md windows.md windows-portable.md current-data.json; do
        install -Dm644 "rust/docs/$doc" "$pkgdir/usr/share/doc/$pkgname/docs/$doc"
    done
}
