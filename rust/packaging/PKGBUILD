# Local Artix/Arch package built from the adjacent, generated source archive.
pkgname=awakened-poe-trade-rs
pkgver=0.17.0
pkgrel=1
pkgdesc='Native Rust PoE overlay preview for River and XWayland'
arch=('x86_64')
url='https://github.com/SnosMe/awakened-poe-trade'
license=('MIT')
# Cargo already performs Rust thin-LTO. GCC LTO objects from ring cannot be
# consumed by rust-lld; disable makepkg's additional C/C++ LTO for this package.
options=('!lto')
depends=('gtk3' 'gtk-layer-shell' 'wl-clipboard' 'xdotool' 'coreutils' 'xdg-utils' 'libnotify')
makedepends=('rust' 'pkgconf')
source=("native-source-${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$srcdir/rust"
    export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$srcdir/target}"
    cargo build --release --locked --offline -j 3
}

check() {
    cd "$srcdir/rust"
    export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$srcdir/target}"
    cargo test --locked --offline -j 3
}

package() {
    cd "$srcdir"
    local target_dir="${CARGO_TARGET_DIR:-$srcdir/target}"
    install -Dm755 "$target_dir/release/awakened-poe-trade-rs" "$pkgdir/usr/bin/awakened-poe-trade-rs"
    install -Dm755 rust/packaging/awakened-poe-trade-rs-launch "$pkgdir/usr/bin/awakened-poe-trade-rs-launch"
    install -Dm644 rust/packaging/awakened-poe-trade-rs.desktop "$pkgdir/usr/share/applications/awakened-poe-trade-rs.desktop"
    install -Dm644 main/build/icons/128x128.png "$pkgdir/usr/share/icons/hicolor/128x128/apps/awakened-poe-trade-rs.png"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    cp -a license-bundle "$pkgdir/usr/share/licenses/$pkgname/dependencies"
    install -Dm644 rust/README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 rust/docs/PORTING.md "$pkgdir/usr/share/doc/$pkgname/PORTING.md"
    install -Dm644 rust/docs/MACHINE.md "$pkgdir/usr/share/doc/$pkgname/MACHINE.md"
    install -Dm644 rust/docs/VALIDATION.md "$pkgdir/usr/share/doc/$pkgname/VALIDATION.md"
    install -Dm644 rust/docs/parser-measurements-0.2.json "$pkgdir/usr/share/doc/$pkgname/parser-measurements-0.2.json"
    install -Dm644 rust/docs/economy-cache-measurements-0.2.json "$pkgdir/usr/share/doc/$pkgname/economy-cache-measurements-0.2.json"
    install -Dm644 rust/docs/stat-translations-0.3.json "$pkgdir/usr/share/doc/$pkgname/stat-translations-0.3.json"
    install -Dm644 rust/docs/stopwatch-parity.json "$pkgdir/usr/share/doc/$pkgname/stopwatch-parity.json"
    install -Dm644 rust/docs/delve-parity.json "$pkgdir/usr/share/doc/$pkgname/delve-parity.json"
    install -Dm644 rust/docs/stopwatch-lifecycle-0.17.json "$pkgdir/usr/share/doc/$pkgname/stopwatch-lifecycle-0.17.json"
    install -Dm644 rust/docs/stopwatch-real-0.17.json "$pkgdir/usr/share/doc/$pkgname/stopwatch-real-0.17.json"
    install -Dm644 rust/docs/delve-lifecycle-0.17.json "$pkgdir/usr/share/doc/$pkgname/delve-lifecycle-0.17.json"
    install -Dm644 rust/docs/overlay-lifecycle-0.17.json "$pkgdir/usr/share/doc/$pkgname/overlay-lifecycle-0.17.json"
    install -Dm644 rust/docs/settings-0.17.json "$pkgdir/usr/share/doc/$pkgname/settings-0.17.json"
    install -Dm644 rust/docs/item-search-lifecycle-0.17.json "$pkgdir/usr/share/doc/$pkgname/item-search-lifecycle-0.17.json"
    install -Dm644 rust/docs/delve-0.16.json "$pkgdir/usr/share/doc/$pkgname/delve-0.16.json"
    install -Dm644 rust/docs/delve-lifecycle-0.16.json "$pkgdir/usr/share/doc/$pkgname/delve-lifecycle-0.16.json"
    install -Dm644 rust/docs/overlay-lifecycle-0.16.json "$pkgdir/usr/share/doc/$pkgname/overlay-lifecycle-0.16.json"
    install -Dm644 rust/docs/settings-0.16.json "$pkgdir/usr/share/doc/$pkgname/settings-0.16.json"
    install -Dm644 rust/docs/item-search-lifecycle-0.16.json "$pkgdir/usr/share/doc/$pkgname/item-search-lifecycle-0.16.json"
    install -Dm644 rust/docs/item-search-0.15.json "$pkgdir/usr/share/doc/$pkgname/item-search-0.15.json"
    install -Dm644 rust/docs/item-search-lifecycle-0.15.json "$pkgdir/usr/share/doc/$pkgname/item-search-lifecycle-0.15.json"
    install -Dm644 rust/docs/virtual-item-identity-0.15.json "$pkgdir/usr/share/doc/$pkgname/virtual-item-identity-0.15.json"
    install -Dm644 rust/docs/overlay-lifecycle-0.15.json "$pkgdir/usr/share/doc/$pkgname/overlay-lifecycle-0.15.json"
    install -Dm644 rust/docs/settings-0.15.json "$pkgdir/usr/share/doc/$pkgname/settings-0.15.json"
    install -Dm644 rust/docs/hotkeys-0.14.json "$pkgdir/usr/share/doc/$pkgname/hotkeys-0.14.json"
    install -Dm644 rust/docs/settings-0.14.json "$pkgdir/usr/share/doc/$pkgname/settings-0.14.json"
    install -Dm644 rust/docs/overlay-lifecycle-0.14.json "$pkgdir/usr/share/doc/$pkgname/overlay-lifecycle-0.14.json"
    install -Dm644 rust/docs/poeprices-availability-0.14.json "$pkgdir/usr/share/doc/$pkgname/poeprices-availability-0.14.json"
    install -Dm644 rust/docs/unidentified-0.13.json "$pkgdir/usr/share/doc/$pkgname/unidentified-0.13.json"
    install -Dm644 rust/docs/overlay-lifecycle-0.13.json "$pkgdir/usr/share/doc/$pkgname/overlay-lifecycle-0.13.json"
    install -Dm644 rust/docs/economy-0.12.json "$pkgdir/usr/share/doc/$pkgname/economy-0.12.json"
    install -Dm644 rust/docs/overlay-lifecycle-0.12.json "$pkgdir/usr/share/doc/$pkgname/overlay-lifecycle-0.12.json"
    install -Dm644 rust/docs/overlay-lifecycle-0.11.json "$pkgdir/usr/share/doc/$pkgname/overlay-lifecycle-0.11.json"
    install -Dm644 rust/docs/mercenary-0.11.json "$pkgdir/usr/share/doc/$pkgname/mercenary-0.11.json"
    install -Dm644 rust/docs/special-presets-0.10.json "$pkgdir/usr/share/doc/$pkgname/special-presets-0.10.json"
    install -Dm644 rust/docs/overlay-lifecycle-0.10.json "$pkgdir/usr/share/doc/$pkgname/overlay-lifecycle-0.10.json"
    install -Dm644 rust/docs/overlay-lifecycle-0.9.json "$pkgdir/usr/share/doc/$pkgname/overlay-lifecycle-0.9.json"
    install -Dm644 rust/docs/equipment-presets-0.8.json "$pkgdir/usr/share/doc/$pkgname/equipment-presets-0.8.json"
    install -Dm644 rust/docs/item-filters-0.7.json "$pkgdir/usr/share/doc/$pkgname/item-filters-0.7.json"
    install -Dm644 rust/docs/presets-0.6.json "$pkgdir/usr/share/doc/$pkgname/presets-0.6.json"
    install -Dm644 rust/docs/inspection-0.5.json "$pkgdir/usr/share/doc/$pkgname/inspection-0.5.json"
    install -Dm644 rust/docs/calculated-filters-0.4.json "$pkgdir/usr/share/doc/$pkgname/calculated-filters-0.4.json"
}
