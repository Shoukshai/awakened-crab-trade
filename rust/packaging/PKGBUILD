# Local Artix/Arch package built from the adjacent, generated source archive.
pkgname=awakened-crab-trade
pkgver=0.30.0
pkgrel=1
provides=("awakened-poe-trade-rs=$pkgver")
conflicts=('awakened-poe-trade-rs')
replaces=('awakened-poe-trade-rs')
pkgdesc='Native Rust PoE price checker for River and XWayland'
arch=('x86_64')
url='https://github.com/Shoukshai/awakened-crab-trade'
license=('MIT')
# Cargo already performs Rust thin-LTO. GCC LTO objects from ring cannot be
# consumed by rust-lld; disable makepkg's additional C/C++ LTO for this package.
options=('!lto')
depends=('gtk3' 'gtk-layer-shell' 'wl-clipboard' 'xdotool' 'coreutils' 'xdg-utils' 'libnotify')
makedepends=('rust' 'pkgconf')
source=("native-source-${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$srcdir/rust"
    export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$srcdir/target}"
    cargo build --release --locked --offline -j 3
}

check() {
    cd "$srcdir/rust"
    export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$srcdir/target}"
    cargo test --locked --offline --bin awakened-poe-trade-rs -j 3
}

package() {
    cd "$srcdir"
    local target_dir="${CARGO_TARGET_DIR:-$srcdir/target}"
    install -Dm755 "$target_dir/release/awakened-poe-trade-rs" "$pkgdir/usr/bin/awakened-poe-trade-rs"
    install -Dm755 rust/packaging/awakened-poe-trade-rs-launch "$pkgdir/usr/bin/awakened-poe-trade-rs-launch"
    install -Dm644 rust/packaging/awakened-poe-trade-rs.desktop "$pkgdir/usr/share/applications/awakened-poe-trade-rs.desktop"
    install -Dm644 rust/assets/branding/icon-256.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/awakened-crab-trade.png"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    cp -a license-bundle "$pkgdir/usr/share/licenses/$pkgname/dependencies"
    install -Dm644 rust/README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    for doc in PORTING.md QUICKSTART.md CHECKER-VALIDATION.md GAME-ART.md; do
        install -Dm644 "rust/docs/$doc" "$pkgdir/usr/share/doc/$pkgname/$doc"
    done
    for report in current-data-0.26.json price-checker-lifecycle-0.25.json price-checker-real-0.25.json price-checker-real-0.23.json \
        parser-measurements-0.2.json stat-translations-0.3.json calculated-filters-0.4.json \
        presets-0.6.json item-filters-0.7.json equipment-presets-0.8.json \
        special-presets-0.10.json mercenary-0.11.json economy-0.12.json unidentified-0.13.json; do
        install -Dm644 "rust/docs/$report" "$pkgdir/usr/share/doc/$pkgname/$report"
    done
}
